#SCAN


alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Perimeter Network Reconnaissance by Suspicious HOST"; program: snort; content: "Classification|3a| Detection of a Network Scan"; classtype: nist-recon; xbits: isset,by_src,attacker_suspicious;  xbits: set,attacker_scan,86400; threshold: type limit, track by_dst, count 1, seconds 36000; normalize; reference: url, milituscyber.com; sid:3000080; pri:7; rev: 1;)

# DOS

alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Denial of Service Attack by Suspicious HOST"; program: bro_weird; content: "baroque_SYN"; classtype: attempted-dos; xbits: isset,by_src,attacker_suspicious; xbits: set,dos,86400; normalize; reference: url, milituscyber.com; sid:3000085; after: track by_both, count 40, seconds 60; threshold: type limit, track by_dst, count 5, seconds 60; rev:1;)
alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Denial of Service Attack by Suspicious HOST"; program: bro_weird; content: "TCP_ack_underflow_or_misorder"; classtype: attempted-dos; xbits: isset,by_src,attacker_suspicious;  xbits: set,dos,86400; normalize; reference: url, milituscyber.com; sid:3000086; after: track by_both, count 40, seconds 60; threshold: type limit, track by_dst, count 5, seconds 60; rev:1;)


# BRUTE FORCE

alert any $EXTERNAL_NET any -> $HOME_NET $TCP_PORTS (msg: "[MILITUS ATTACK] Brute-Force Attack by Suspicious HOST"; program: snort; content: "brute force"; nocase; classtype: nist-impact; xbits: isset,by_src,attacker_suspicious; xbits: set,bruteforce_attack,6000; after: track by_both, count 30, seconds 60; threshold: type limit, track by_src, count 1, seconds 600; normalize;  reference: url, milituscyber.com; sid:3000087; pri:5; rev: 1;)


alert any $EXTERNAL_NET any -> $HOME_NET $FTP_PORT (msg: "[MILITUS ATTACK] FTP Login Successful by Suscpicious HOST"; program: snort; content: "FTP Login Successful"; classtype: nist-impact; xbits: isset,both,bruteforce_attack; xbits:set,successful_login,6000; xbits: set, compromised_host, 86400; threshold: type limit, track by_src, count 1, seconds 60; normalize; reference: url, milituscyber.com; sid:3000089; pri:4; rev: 1;)


alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Suspicious Activity on Compromised Host"; program: pvs; content:"tracked|2d|session"; classtype: nist-impact;  xbits: isset,src_xbitdst,attacker_suspicious; xbits: set,track_session,67000; xbits: set, compromised_host, 86400; threshold: type limit, track by_src, count 1, seconds 60; normalize; reference: url, milituscyber.com; sid:3000090; pri:1; rev: 1;)

