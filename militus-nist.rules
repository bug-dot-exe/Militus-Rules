#Perform perimeter network reconnaissance
alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Perimeter Network Reconnaissance"; program: snort; content: "ET SCAN"; classtype: nist-recon; xbits: set,attacker_target,86400; threshold: type limit, track by_src, count 1, seconds 36000; normalize; reference: url, milituscyber.com; sid:1000001; pri:7; rev: 1;)
alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Perimeter Network Reconnaissance"; program: snort; content: "Classification|3a| Detection of a Network Scan"; classtype: nist-recon; threshold: type limit, track by_src, count 1, seconds 36000; normalize; reference: url, milituscyber.com; sid:1000002; pri:7; rev: 1;)
alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Perimeter Network Reconnaissance"; program: snort; content: "Classification|3a| Large Scale Information Leak"; classtype: nist-recon; xbits: set,attacker_target,86400; normalize; threshold: type limit, track by_src, count 1, seconds 36000; reference: url, milituscyber.com; sid:1000003; pri:7; rev: 1;)
alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Perimeter Network Reconnaissance"; program: snort; content: "Classification|3a| Information Leak"; classtype: nist-recon; normalize; threshold: type limit, track by_src, count 1, seconds 36000; reference: url, milituscyber.com; sid:1000004; pri:7; rev: 1;)


#Conduct simple Denial of Service attack
alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Denial of Service Attack[1]"; program: bro_weird; content: "baroque_SYN"; classtype: attempted-dos;  xbits: set,dos,86400; normalize; reference: url, milituscyber.com; sid:1000006; after: track by_dst, count 10, seconds 60; threshold: type limit, track by_dst, count 5, seconds 60; rev:1;)
alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Denial of Service Attack[20]"; program: bro_weird; content: "TCP_ack_underflow_or_misorder"; classtype: attempted-dos; xbits: set,dos,86400; normalize; reference: url, milituscyber.com; sid:1000008; after: track by_dst, count 10, seconds 60; threshold: type limit, track by_dst, count 5, seconds 60; rev:1;)

                                                                                            
                                                                                   ####NIST CORRELATED####
#Compromise Software of Organization

#policy Violation
#alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Policy Violation"; program: snort; content: "Classification|3a| Potential Corporate Privacy Violation"; classtype: nist-impact; xbits: set,attacker_target,67000; xbits:noalert; threshold: type limit, track by_src, count 1, seconds 60; normalize; reference: url, milituscyber.com; sid:10000031; pri:7; rev: 1;)



#Exploit Code

#Bad Blue Exploit Code
alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Successful Compromise of software"; program: snort; content: "Classification|3a| Executable code was detected"; classtype: nist-impact; xbits: isset,dst_xbitsrc,attacker_suspicious; xbits: set,attacker_target,86400; after: track by_dst, count 1, seconds 3; threshold: type limit, track by_src, count 1, seconds 6000; normalize; reference: url, milituscyber.com; sid:10000033; pri:5; rev: 1;)


#Generic

#SMB
alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Unauthorized Service Command"; program: snort; content: "Classification|3a| Generic Protocol Command Decode"; classtype: nist-impact; xbits: set,attacker_target,86400; xbits:noalert; threshold: type limit, track by_src, count 1, seconds 60; normalize; reference: url, milituscyber.com; sid:10000034; pri:5; rev: 1;)

#IRC
alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Misc Attack"; program: snort; content: "Classification|3a| Misc Attack"; classtype: nist-impact; xbits: set,attacker_target,86400; xbits:noalert; threshold: type limit, track by_src, count 1, seconds 60; normalize; reference: url, milituscyber.com; sid:10000035; pri:4; rev: 1;)

#Web app

#web Attack
#alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Vulnerable Web Application "; program: snort; content: "Classification|3a| Web Application Attack"; classtype: nist-impact; xbits: set,attacker_target,86400; threshold: type limit, track by_src, count 1, seconds 60; normalize; reference: url, milituscyber.com; sid:10000036; pri:6; rev: 1;)
#vulnerable web app
#alert any $HOME_NET any -> $EXTERNAL_NET any (msg: "[MILITUS ATTACK] Highly Vulnerable Web Application"; program: snort; content: "Classification|3a| access to a potentially vulnerable web application"; classtype: nist-impact; xbits: set,attacker_target,86400; threshold: type limit, track by_src, count 1, seconds 90; normalize; reference: url, milituscyber.com; sid:10000037; pri:4; rev: 1;)


#Upload Net cat Exe File
#Malware Activity
alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Malware Activity"; program: snort; content: "Classification|3a| A Network Trojan Was detected"; classtype: nist-impact; xbit: isset,by_src,attacker_suspicious;  xbits:set,attacker_target,86400; threshold: type limit, track by_dst, count 1, seconds 600; normalize; reference: url, milituscyber.com; sid:10000038; pri:3; rev: 1;)


# Admin
#NIST                                                                       UnAuthorized Access
alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Attempted Unauthorized Access"; program: snort; content: "Classification|3a| Attempted Administrator Privilege Gain"; classtype: nist-impact; xbit: isset,dst_xbitsrc,attacker_suspicious;  xbits: set,attacker_target,67000; xbits: set, compromised_host, 86400; threshold: type limit, track by_src, count 1, seconds 1000; normalize; reference: url, milituscyber.com; sid:10000039; pri:5; rev: 1;)



#Gain Access via Netcat, listen  ----- Admin
alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Obtained Unauthorized Admin Access"; program: snort; content: "Classification|3a| Successful Administrator Privilege Gain"; classtype: nist-impact; xbits:isset,src_xbitdst,attacker_target; xbits: set,admin_access,67000; xbits: set, compromised_host, 86400; threshold: type limit, track by_src, count 1, seconds 1000; normalize; reference: url, milituscyber.com; sid:10000040; pri:1; rev: 1;)
alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Likely Obtained Unauthorized Admin Access"; program: snort; content: "Classification|3a| Successful Administrator Privilege Gain"; classtype: nist-impact; xbits:isnotset,src_xbitdst,attacker_target; xbits: set,admin_access,67000; xbits: set, compromised_host, 86400; threshold: type limit, track by_src, count 1, seconds 1000; normalize; reference: url, milituscyber.com; sid:10000058; pri:2; rev: 1;)

# User
#
alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Attempted Unauthorized User Access"; program: snort; content: "Classification|3a| Unsuccessful User Privilege Gain"; classtype: nist-impact; xbits:noalert; xbits: set, compromised_host, 86400; xbits: set,attacker_target,67000; threshold: type limit, track by_src, count 10, seconds 300; normalize; reference: url, milituscyber.com; sid:10000041; pri:5; rev: 1;)
#alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Likely Attempted UnAuthorized User Access"; program: snort; content: "Classification|3a| Unsuccessful User Privilege Gain"; classtype: nist-impact; xbits:noalert; xbits: set,attacker_target,67000; threshold: type limit, track by_src, count 10, seconds 300; normalize; reference: url, milituscyber.com; sid:10000042; pri:6; rev: 1;)

#VSFTPD
alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Obtained Unauthorized Admin Shell Access"; program: snort; content: "id check returned root"; classtype: nist-impact; xbits:isset,src_xbitdst,attacker_target; xbits: set,admin_access,67000; threshold: type limit, track by_src, count 1, seconds 1200; normalize; reference: url, milituscyber.com; sid:10000043; pri:1; rev: 1;)
alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Likely Obtained Unauthorized Admin Shell Access"; program: snort; content: "id check returned root"; classtype: nist-impact; xbits:isnotset,src_xbitdst,attacker_target; xbits: set,admin_access,67000; xbits: set, compromised_host, 86400; normalize; reference: url, milituscyber.com; sid:10000044; pri:2; rev: 1;)

#alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Likely Obtained Unauthorized Admin Shell Access"; program: snort; content: "id check returned root"; classtype: nist-impact; xbits: set,admin_access,67001;  normalize; reference: url, milituscyber.com; sid:10001044; pri:2; rev: 1;)
#alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Likely Obtained Unauthorized Admin Shell Access"; program: snort; content: "id check returned root"; classtype: nist-impact; xbits: set,admin_access,67001; threshold: type limit, track by_src, count 1, seconds 1200; normalize; reference: url, milituscyber.com; sid:10001044; pri:2; rev: 1;)

#distcc
alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Unauthorized User Access to Web Server"; program: snort; content: "id command from HTTP server"; classtype: nist-impact; xbits:isset,src_xbitdst,attacker_target; xbits: set,user_access,67000; xbits: set, compromised_host, 86400; threshold: type limit, track by_src, count 1, seconds 1200; normalize; reference: url, milituscyber.com; sid:10000045; pri:3; rev: 1;)
alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Likely Unauthorized User Access to Web Server"; program: snort; content: "id command from HTTP server"; classtype: nist-impact; xbits:isnotset,src_xbitdst,attacker_target; xbits: set,user_access,67000; xbits: set, compromised_host, 86400; threshold: type limit, track by_src, count 1, seconds 1200; normalize; reference: url, milituscyber.com; sid:10000046; pri:4; rev: 1;)

#vlc
alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Malware Download from Web Server"; program: snort; content: "WEB_CLIENT"; content:!"misc-activity"; classtype: nist-impact; xbits:isset,dst_xbitsrc,attacker_target; xbits: set,user_access,67000; xbits: set, compromised_host, 86400; threshold: type limit, track by_src, count 1, seconds 1200; normalize; reference: url, milituscyber.com; sid:10000047; pri:4; rev: 1;)
alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Suspicious Download from Web Server "; program: snort; content: "WEB_CLIENT"; content: !"misc-activity"; classtype: nist-impact; xbits:isnotset,dst_xbitsrc,attacker_target; xbits: set,user_access,67000; xbits: set, compromised_host, 86400; threshold: type limit, track by_src, count 1, seconds 1200; normalize; reference: url, milituscyber.com; sid:10000048; pri:5; rev: 1;)

alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Suspicious Activity from Web Server"; program: snort; content:"WEB_SERVER"; content: !"web-application-activity";  classtype: nist-impact; xbits:isset,dst_xbitsrc,attacker_target; xbits: set,user_access,67000; xbits: set, compromised_host, 86400; threshold: type limit, track by_src, count 1, seconds 1200; normalize; reference: url, milituscyber.com; sid:10000049; pri:4; rev: 1;)
#alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Suspicious Download from Web Server "; program: snort; content: "WEB_SERVER"; classtype: nist-impact; xbits:isnotset,dst_xbitsrc,attacker_target; xbits: set,user_access,67000; threshold: type limit, track by_src, count 1, seconds 60; normalize; reference: url, milituscyber.com; sid:10000050; pri:1; rev: 1;)




alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Sensitive Data Exfiltration Through Compromised Host"; program: snort; content: "sensitive_data|3a|"; content:!"email"; nocase; classtype: nist-impact; xbits: isset,reverse,admin_access; xbits: set, compromised_host, 86400; threshold: type limit, track by_dst, count 1, seconds 3200; normalize; reference: url, milituscyber.com; sid:10000053; pri:1; rev: 1;)


#Brute Force Attempts
#Tested By FTP BruteForce Using Xhydra


alert any $EXTERNAL_NET any -> $HOME_NET $TCP_PORTS (msg: "[MILITUS ATTACK] Brute-Force Attack "; program: snort; content: "brute force"; classtype: nist-impact; xbits: set,bruteforce_attack,6000; after: track by_dst, count 30, seconds 60; threshold: type limit, track by_src, count 1, seconds 1200; normalize;  reference: url, milituscyber.com; sid:10000055; pri:5; rev: 1;)

#######################################################


#FTP  Brute Force 

alert any $EXTERNAL_NET any -> $HOME_NET $TCP_PORTS (msg: "[MILITUS ATTACK] Brute Force Attempt on FTP"; program: snort; content: "Unsuccessful User Privilege Gain"; classtype: nist-impact; xbits: set,bruteforce_attack,6000; after: track by_dst, count 1, seconds 3600; threshold: type limit, track by_src, count 1, seconds 60; normalize; reference: url, milituscyber.com; sid:10000070; pri:6; rev: 1;)
alert any $EXTERNAL_NET any -> $HOME_NET 21 (msg: "[MILITUS ATTACK] FTP Login Successful"; program: snort; content: "ET POLICY FTP Login Successful"; classtype: nist-impact; xbits: isset,both,bruteforce_attack|attacker_recon; xbits:set,successful_login,6000; xbits: set, compromised_host, 86400; threshold: type limit, track by_src, count 1, seconds 60; normalize; reference: url, milituscyber.com; sid:10000057; pri:5; rev: 1;)


#

alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Activity on Compromised Host"; program: pvs; content:"tracked|2d|session"; classtype: nist-impact; xbits: set,track_session,67000; xbits: set, compromised_host, 86400; threshold: type limit, track by_src, count 1, seconds 900; normalize; reference: url, milituscyber.com; sid:10000084; pri:1; rev: 1;)

#Lateral Movement

alert any any any -> $HOME_NET any (msg: "[MILITUS ATTACK] Shellcode Execution"; program: snort; content: "ET SHELLCODE"; classtype: traffic-normal; xbits: set, executable_code, 86400; xbits: noalert; normalize; reference: url, milituscyber.com; sid:4005018; pri:7; rev: 1;)

alert any $HOME_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Internal Network Reconnaissance"; program: snort; content: "ET SCAN"; classtype: nist-recon; xbits:isset,by_src,executable_code; xbits:set, lm_attacker_scan, 86400; xbits: noalert; normalize; reference: url, milituscyber.com; sid:4005019; pri:7; rev: 1;)
alert any $HOME_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Perimeter Network Reconnaissance"; program: snort; content: "Classification|3a| Detection of a Network Scan"; classtype: nist-recon; xbits:isset,by_src,executable_code;xbits:set, lm_attacker_scan, 86400; xbits: noalert; normalize; reference: url, milituscyber.com; sid:4005020; pri:7; rev: 1;)
alert any $HOME_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Internal Network Reconnaissance"; program: snort; content: "Classification|3a| Large Scale Information Leak"; classtype: nist-recon; xbits:isset,by_src,executable_code; xbits:set, lm_attacker_scan, 86400; xbits: noalert; normalize; reference: url, milituscyber.com; sid:4005021; pri:7; rev: 1;)
alert any $HOME_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Internal Network Reconnaissance"; program: snort; content: "Classification|3a| Information Leak"; classtype: nist-recon; xbits:isset,by_src,executable_code;xbits:set, lm_attacker_scan, 86400; xbits: noalert; normalize; reference: url, milituscyber.com; sid:4005022; pri:7; rev: 1;)
#alert any $HOME_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Internal Network Reconnaissance"; program: snort; content: "Classification|3a| Potentially Bad Traffic"; classtype: nist-recon; xbits: isset,by_src,executable_code; xbits:set, lm_attacker_scan, 86400; xbits:noalert; normalize; reference: url, milituscyber.com; sid:4005023; pri:7; rev: 1;)

alert any $HOME_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Internal Brute Force"; prog: bro_conn; content: "ShAdfDr"; threshold: type limit, track by_src, count 1, seconds 300; classtype: brute-force; xbits: isset,reverse,lm_attacker_scan; xbits:set, lm_brute_force, 86400; normalize; reference: url, milituscyber.com; sid:4005024; pri: 2; rev:1;)


#Compliance Based Rules


#Clear Text passwords
#alert any any any -> any any any (msg: "[MILITUS POLICY] Client Data Leakage"; program: pvs; content: "Client Data Leakage Detection"; classtype: nist-impact; xbits:set,client_data,6000; threshold: type limit, track by_src, count 1, seconds 300; normalize; reference: url, milituscyber.com; sid:10000059; pri:7; rev: 1;)

#alert any $EXTERNAL_NET any -> $HOME_NET $SMTP_PORT (msg: "[MILITUS ATTACK] Attack on SMTP Service"; program: snort; content: "ET SMTP"; content:!"not|2d|suspicious" classtype: nist-impact;  threshold: type limit, track by_src, count 1, seconds 600; normalize; reference: url, milituscyber.com; sid:10000060; pri:6; rev: 1;)

#alert any $EXTERNAL_NET any -> $HOME_NET $SMTP_PORT (msg: "[MILITUS ATTACK] Attack on SMTP Service"; program: snort; content: "GPL SMTP"; content:!"not|2d|suspicious"   classtype: nist-impact; threshold: type limit, track by_src, count 1, seconds 600; normalize; reference: url, milituscyber.com; sid:10000061; pri:7; rev: 1;)

#alert any $EXTERNAL_NET any -> $HOME_NET any (msg: "[MILITUS ATTACK] Attack on SQL Server"; program: snort; content: "GPL SQL";  content:!"bad|2d|unknown; classtype: nist-impact; threshold: type limit, track by_src, count 1, seconds 600; normalize; reference: url, milituscyber.com; sid:10000062; pri:7; rev: 1;)

#alert any $EXTERNAL_NET any -> $HOME_NET $POP3_PORT (msg: "[MILITUS ATTACK] Attack on POP3"; program: snort; content: "GPL POP3";  classtype: nist-impact; threshold: type limit, track by_src, count 1, seconds 600; normalize; reference: url, milituscyber.com; sid:10000064; pri:7; rev: 1;)

#alert any any any -> any any any (msg: "[MILITUS ATTACK] Attack on SNMP Service"; program: snort; content: "ET SNMP"; classtype: nist-impact; threshold: type limit, track by_dst, count 1, seconds 600; normalize; reference: url, milituscyber.com; sid:10000066; pri:7; rev: 1;)

#alert any $EXTERNAL_NET any -> $HOME_NET $TELNET_PORT (msg: "[MILITUS ATTACK] Attack on  Telnet Service"; program: snort; content: "ET TELNET"; content:!"bad|2d|unknown;  classtype: nist-impact; threshold: type limit, track by_src, count 1, seconds 600; normalize; reference: url, milituscyber.com; sid:10000067; pri:7; rev: 1;)

#alert any $EXTERNAL_NET any -> $HOME_NET $TELNET_PORT (msg: "[MILITUS ATTACK] Attack on Telnet Service"; program: snort; content: "GPL TELNET"; content:!"bad|2d|unknown"; classtype: nist-impact;  threshold: type limit, track by_src, count 1, seconds 600; normalize; reference: url, milituscyber.com; sid:10000068; pri:7; rev: 1;)

#alert any $EXTERNAL_NET any -> $HOME_NET $TELNET_PORT (msg: "[MILITUS ATTACK] Attack on Telnet Service"; program: snort; content: "GPL TELNET"; after: track by_dst, count 10, seconds 60; classtype: nist-impact;  threshold: type limit, track by_src, count 1, seconds 600; normalize; reference: url, milituscyber.com; sid:10000075; pri:7; rev: 1;)


#alert any any  any -> any any (msg: "[MILITUS POLICY] TOR EXIT NODES "; program: snort; content: "Tor Exit Node"; classtype: nist-impact;  threshold: type limit, track by_src, count 1, seconds 36000; normalize; reference: url, milituscyber.com; sid:10000063; pri:7; rev: 1;)

#alert any any any -> any any (msg:"[MILITUS TEST] Exploit Attempt"; program: snort; meta_content: "%sagan%",$EXPLOIT; classtype: suspicious-traffic; normalize; reference: milituscyber.com; sid: 10000078; rev:1;)






#alert any any any -> any any (msg: "[MILITUS TEST] Possible Coin Mining Bot Activity"; program:snort; meta_content: "%sagan%", $MINING; classtype: traffic-coin-mining; normalize; threshold: type limit, track by_dst, count 1, seconds 1; reference: url, milituscyber.com; sid: 500003; pri :5; rev:1;)



